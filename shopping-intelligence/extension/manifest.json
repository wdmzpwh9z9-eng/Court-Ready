{
  "manifest_version": 3,
  "name": "Aura — AI Shopping Intelligence",
  "version": "0.1.0",
  "description": "See past the price tag. Aura detects the product you're viewing and surfaces cheaper alternatives, overpricing alerts, quality scores, and authenticity signals.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Aura Shopping Intelligence",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/extractors.js", "content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
